# REMINISCENCE — environment configuration example
# Copy to .env for local development.  All values are OPTIONAL; the app runs
# with sensible defaults and remains fully functional offline.
# NOTE: no API keys are required or used by the core product.

# --- Storage ---------------------------------------------------------------
REMINISCENCE_DATA_DIR=./data
REMINISCENCE_DB_PATH=./data/reminiscence.sqlite
REMINISCENCE_MODEL_DIR=./models
REMINISCENCE_MEDIA_DIR=./data/media

# --- Logging / privacy -----------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
REMINISCENCE_LOG_LEVEL=INFO
# Never log raw memory/document content unless explicitly enabled (dev only).
REMINISCENCE_DEBUG_CONTENT=0
# Telemetry is OFF by default and there is no cloud endpoint to send it to.
REMINISCENCE_TELEMETRY=0

# --- AI runtime ------------------------------------------------------------
# Prefer the Qualcomm QNN execution provider when it is actually available.
# Acceleration is only claimed when the provider is detected at runtime.
REMINISCENCE_PREFER_NPU=1
# Heavy VLM reasoning stays disabled until a verified accelerated path exists.
REMINISCENCE_ALLOW_VLM=0
REMINISCENCE_EMBEDDING_MODEL=all-MiniLM-L6-v2
REMINISCENCE_ASR_MODEL=whisper-base
REMINISCENCE_OCR_MODEL=
REMINISCENCE_LLM_MODEL=

# --- Processing ------------------------------------------------------------
REMINISCENCE_WORKERS=4
REMINISCENCE_MAX_FILE_SIZE=536870912
REMINISCENCE_VECTOR_INDEX=numpy

# REMINISCENCE — example environment configuration
# Copy to .env and adjust. Load into your shell before running the app, e.g.:
#   set -a && . ./.env && set +a          (bash/zsh)
# Full documentation & validation rules: docs/ENVIRONMENT.md
# Precedence: CLI flags > these variables > built-in defaults.

# --- Storage ---------------------------------------------------------------
# Root data directory (DB + vector index + models). Default: ~/.reminiscence
# Windows: %USERPROFILE%\.reminiscence
REMINISCENCE_DATA_DIR=~/.reminiscence

# --- Logging / privacy -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
REMINISCENCE_LOG_LEVEL=INFO
# WARNING: logs raw document content. Development only — keep unset/false in
# production (privacy, design spec §20). Accepts 1/0 true/false yes/no on/off.
REMINISCENCE_DEBUG_CONTENT=false

# --- Ingestion / workers -----------------------------------------------------
# Background ingestion threads (1–16). Lower on memory-constrained devices.
REMINISCENCE_N_WORKERS=2
# Maximum accepted file size in MB (>= 1).
REMINISCENCE_MAX_FILE_MB=512

# --- Embeddings ----------------------------------------------------------------
# Vector dimensionality (64–4096). Changing it invalidates existing indexes —
# re-import all sources afterwards.
REMINISCENCE_EMBEDDING_DIM=512
# Optional local embedding model path (leave empty for built-in local model).
# Never downloads from the network.
# REMINISCENCE_EMBEDDING_MODEL_PATH=/opt/models/embedder.bin

# --- AI scheduler (Snapdragon routing) -----------------------------------------
# Allow vision-language-model workloads (advanced).
REMINISCENCE_ALLOW_VLM=false
# Comma-separated tasks preferred on NPU when QNN/QAI runtimes are available.
REMINISCENCE_PREFER_NPU_TASKS=embedding,asr,ocr,classifier

# --- Hybrid retrieval weights (ALPHA+BETA+GAMMA+DELTA+EPSILON must sum to ~1.0) -
# score = α·semantic + β·lexical(BM25) + γ·temporal + δ·modality + ε·source
REMINISCENCE_RETRIEVAL_ALPHA=0.45
REMINISCENCE_RETRIEVAL_BETA=0.35
REMINISCENCE_RETRIEVAL_GAMMA=0.10
REMINISCENCE_RETRIEVAL_DELTA=0.05
REMINISCENCE_RETRIEVAL_EPSILON=0.05
